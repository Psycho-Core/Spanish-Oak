<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>PsychoFlash.Core</AssemblyName>
    <RootNamespace>PsychoFlash.Core</RootNamespace>
