    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>PsychoFlash core: SAE J2534 interop, ISO-TP transport and Ford EEC-VI (Spanish Oak) flashing protocol.</Description>
  </PropertyGroup>

</Project>
