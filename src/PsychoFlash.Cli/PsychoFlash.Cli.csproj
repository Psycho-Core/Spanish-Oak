<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>psychoflash</AssemblyName>
    <RootNamespace>PsychoFlash.Cli</RootNamespace>
    <Nullable>disable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.4.0</Version>
    <Description>PsychoFlash command line interface for Ford EEC-VI (Spanish Oak) PCM flashing.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PsychoFlash.Core\PsychoFlash.Core.csproj" />
  </ItemGroup>

</Project>
